/* Setup shell, hierarchy, surfaces, and state messaging. */
.bootstrap-shell {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--bootstrap-bg);
}

.bootstrap-header {
    flex-shrink: 0;
    min-height: 72px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--bootstrap-border);
    background-color: var(--bootstrap-surface-strong);
}

.bootstrap-header__brand {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.bootstrap-header__logo {
    width: 40px;
    min-width: 40px;
    height: 40px;
    margin-right: var(--bootstrap-space-3);
    -unity-background-scale-mode: scale-to-fit;
}

.bootstrap-header__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-header__eyebrow {
    margin-bottom: var(--bootstrap-space-1);
    color: var(--bootstrap-accent);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-header__title {
    color: var(--bootstrap-text);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-header__subtitle {
    margin-top: var(--bootstrap-space-1);
    color: var(--bootstrap-text-muted);
    font-size: 11px;
    white-space: normal;
}

.bootstrap-channel {
    flex-shrink: 0;
    min-width: 172px;
    margin-left: var(--bootstrap-space-4);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-2);
    padding-bottom: var(--bootstrap-space-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border-soft);
    border-right-color: var(--bootstrap-border-soft);
    border-top-color: var(--bootstrap-border-soft);
    border-bottom-color: var(--bootstrap-border-soft);
    border-top-left-radius: var(--bootstrap-radius);
    border-top-right-radius: var(--bootstrap-radius);
    border-bottom-right-radius: var(--bootstrap-radius);
    border-bottom-left-radius: var(--bootstrap-radius);
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-channel__label {
    margin-bottom: var(--bootstrap-space-1);
    color: var(--bootstrap-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
}

.bootstrap-channel__value {
    color: var(--bootstrap-text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-work-area {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.bootstrap-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.bootstrap-content-scroll > .unity-scroll-view__content-viewport {
    min-width: 0;
    min-height: 0;
}

.bootstrap-content {
    flex-grow: 1;
    min-width: 0;
    padding-left: var(--bootstrap-space-6);
    padding-right: var(--bootstrap-space-6);
    padding-top: var(--bootstrap-space-4);
    padding-bottom: var(--bootstrap-space-4);
}

.bootstrap-section {
    flex-shrink: 0;
    min-width: 0;
    margin-bottom: var(--bootstrap-space-4);
}

.bootstrap-section__heading {
    margin-bottom: var(--bootstrap-space-2);
    color: var(--bootstrap-text-muted);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-surface {
    min-width: 0;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border);
    border-right-color: var(--bootstrap-border);
    border-top-color: var(--bootstrap-border);
    border-bottom-color: var(--bootstrap-border);
    border-top-left-radius: var(--bootstrap-radius);
    border-top-right-radius: var(--bootstrap-radius);
    border-bottom-right-radius: var(--bootstrap-radius);
    border-bottom-left-radius: var(--bootstrap-radius);
    background-color: var(--bootstrap-surface);
}

.bootstrap-surface--raised {
    background-color: var(--bootstrap-surface-raised);
}

.bootstrap-summary {
    flex-direction: row;
    align-items: center;
}

.bootstrap-summary__icon {
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin-right: var(--bootstrap-space-3);
}

.bootstrap-summary__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-summary__title {
    color: var(--bootstrap-text);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-summary__message {
    margin-top: var(--bootstrap-space-1);
    color: var(--bootstrap-text-muted);
    font-size: 12px;
    white-space: normal;
}

.bootstrap-status-strip {
    min-width: 0;
    margin-top: var(--bootstrap-space-3);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-2);
    padding-bottom: var(--bootstrap-space-2);
    flex-direction: row;
    align-items: center;
    border-left-width: 3px;
    border-top-left-radius: var(--bootstrap-radius);
    border-top-right-radius: var(--bootstrap-radius);
    border-bottom-right-radius: var(--bootstrap-radius);
    border-bottom-left-radius: var(--bootstrap-radius);
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-status-strip__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--bootstrap-text);
    font-size: 11px;
    white-space: normal;
}

.bootstrap-status--neutral {
    border-left-color: var(--bootstrap-neutral);
}

.bootstrap-status--info,
.bootstrap-status--working {
    border-left-color: var(--bootstrap-info);
}

.bootstrap-status--success {
    border-left-color: var(--bootstrap-success);
}

.bootstrap-status--warning,
.bootstrap-status--review {
    border-left-color: var(--bootstrap-warning);
}

.bootstrap-status--error {
    border-left-color: var(--bootstrap-error);
}

.bootstrap-progress {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.bootstrap-progress__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-progress__operation {
    color: var(--bootstrap-text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-progress__detail {
    margin-top: var(--bootstrap-space-1);
    color: var(--bootstrap-text-muted);
    font-size: 11px;
    white-space: normal;
}

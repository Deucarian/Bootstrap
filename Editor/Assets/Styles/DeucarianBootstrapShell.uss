/* Bootstrap shell, compact hero, and state messaging. */
.bootstrap-shell {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--bootstrap-bg);
}

.bootstrap-header {
    flex-shrink: 0;
    height: 52px;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--bootstrap-border-soft);
    background-color: var(--bootstrap-surface-raised);
}

.bootstrap-header__brand {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.bootstrap-header__logo {
    width: 26px;
    min-width: 26px;
    height: 26px;
    margin-right: var(--bootstrap-space-2);
    -unity-background-scale-mode: scale-to-fit;
}

.bootstrap-header__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.bootstrap-header__title {
    color: var(--bootstrap-text);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.bootstrap-header__subtitle {
    margin-top: 1px;
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
}

.bootstrap-channel {
    flex-shrink: 0;
    min-width: 92px;
    max-width: 152px;
    min-height: 28px;
    margin-left: var(--bootstrap-space-3);
    padding-left: var(--bootstrap-space-2);
    padding-right: var(--bootstrap-space-2);
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border-soft);
    border-right-color: var(--bootstrap-border-soft);
    border-top-color: var(--bootstrap-border-soft);
    border-bottom-color: var(--bootstrap-border-soft);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-channel__value {
    flex-shrink: 1;
    min-width: 0;
    color: var(--bootstrap-text);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.bootstrap-channel .unity-base-popup-field {
    flex-shrink: 0;
    width: 76px;
    min-width: 76px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
}

.bootstrap-channel .unity-base-popup-field__input {
    min-height: 20px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
}

.bootstrap-work-area {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.bootstrap-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.bootstrap-content-scroll > .unity-scroll-view__content-viewport {
    min-width: 0;
    min-height: 0;
}

.bootstrap-content {
    flex-grow: 1;
    min-width: 0;
    width: 100%;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-4);
    padding-bottom: var(--bootstrap-space-4);
}

.bootstrap-surface,
.bootstrap-hero {
    min-width: 0;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-4);
    padding-bottom: var(--bootstrap-space-4);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border);
    border-right-color: var(--bootstrap-border);
    border-top-color: var(--bootstrap-border);
    border-bottom-color: var(--bootstrap-border);
    border-top-left-radius: var(--bootstrap-radius);
    border-top-right-radius: var(--bootstrap-radius);
    border-bottom-right-radius: var(--bootstrap-radius);
    border-bottom-left-radius: var(--bootstrap-radius);
    background-color: var(--bootstrap-surface);
}

.bootstrap-hero {
    flex-shrink: 0;
    min-height: 140px;
    justify-content: center;
}

.bootstrap-summary {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.bootstrap-summary__icon {
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin-right: var(--bootstrap-space-3);
}

.bootstrap-summary__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-summary__title {
    color: var(--bootstrap-text);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-summary__message {
    margin-top: 3px;
    color: var(--bootstrap-text-muted);
    font-size: 12px;
    white-space: normal;
}

.bootstrap-progress-meta {
    min-width: 0;
    margin-top: var(--bootstrap-space-3);
    color: var(--bootstrap-text-muted);
    font-size: 10px;
    white-space: normal;
}

.bootstrap-status-strip,
.bootstrap-offline-strip {
    min-width: 0;
    min-height: 34px;
    margin-top: var(--bootstrap-space-3);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: 7px;
    padding-bottom: 7px;
    flex-direction: row;
    align-items: center;
    border-left-width: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-status-strip__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--bootstrap-text);
    font-size: 10px;
    white-space: normal;
}

.bootstrap-status--neutral {
    border-left-color: var(--bootstrap-neutral);
}

.bootstrap-status--info,
.bootstrap-status--working {
    border-left-color: var(--bootstrap-info);
}

.bootstrap-status--success {
    border-left-color: var(--bootstrap-success);
}

.bootstrap-status--warning,
.bootstrap-status--review {
    border-left-color: var(--bootstrap-warning);
}

.bootstrap-status--error {
    border-left-color: var(--bootstrap-error);
}

/* Width-mode overrides; load after tokens, shell, and components. */
.bootstrap-responsive--compact .bootstrap-content {
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--compact .bootstrap-step {
    flex-basis: 46%;
    min-width: 320px;
}

.bootstrap-responsive--narrow .bootstrap-header {
    min-height: 0;
    align-items: stretch;
    flex-direction: column;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-2);
    padding-bottom: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-header__logo {
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin-right: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-header__title {
    font-size: 16px;
}

.bootstrap-responsive--narrow .bootstrap-channel {
    min-width: 0;
    margin-left: 0;
    margin-top: var(--bootstrap-space-2);
    padding-top: var(--bootstrap-space-1);
    padding-bottom: var(--bootstrap-space-1);
    flex-direction: row;
    align-items: center;
}

.bootstrap-responsive--narrow .bootstrap-channel__label {
    margin-right: var(--bootstrap-space-2);
    margin-bottom: 0;
}

.bootstrap-responsive--narrow .bootstrap-content {
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-section {
    margin-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-surface {
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-summary,
.bootstrap-responsive--narrow .bootstrap-progress {
    align-items: flex-start;
}

.bootstrap-responsive--narrow .bootstrap-steps {
    flex-direction: column;
    margin-right: 0;
}

.bootstrap-responsive--narrow .bootstrap-step {
    width: auto;
    min-width: 0;
    min-height: 0;
    flex-basis: auto;
    margin-right: 0;
}

.bootstrap-responsive--narrow .bootstrap-action-bar {
    min-height: 96px;
    align-items: stretch;
    flex-direction: column;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-2);
    padding-bottom: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-action-bar__summary {
    margin-right: 0;
    margin-bottom: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-action-bar__actions {
    width: 100%;
    min-width: 0;
}

.bootstrap-responsive--narrow .bootstrap-button {
    min-width: 0;
    margin-left: 0;
    margin-right: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-button--primary {
    flex-grow: 1;
    width: auto;
    margin-right: 0;
}

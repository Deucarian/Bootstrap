/* Width-mode overrides; load after tokens, shell, and components. */
.bootstrap-responsive--wide .bootstrap-content {
    width: 100%;
    max-width: 820px;
    align-self: center;
    padding-left: var(--bootstrap-space-6);
    padding-right: var(--bootstrap-space-6);
    padding-top: var(--bootstrap-space-6);
    padding-bottom: var(--bootstrap-space-6);
}

.bootstrap-responsive--wide .bootstrap-plan {
    margin-top: var(--bootstrap-space-4);
}

.bootstrap-responsive--compact .bootstrap-content {
    width: 100%;
    max-width: 720px;
    align-self: center;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: var(--bootstrap-space-4);
    padding-bottom: var(--bootstrap-space-4);
}

.bootstrap-responsive--narrow .bootstrap-header {
    height: 52px;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-header__logo {
    width: 24px;
    min-width: 24px;
    height: 24px;
}

.bootstrap-responsive--narrow .bootstrap-header__subtitle {
    display: none;
}

.bootstrap-responsive--narrow .bootstrap-channel {
    min-width: 82px;
    max-width: 128px;
    margin-left: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-content {
    width: 100%;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-surface,
.bootstrap-responsive--narrow .bootstrap-hero {
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-summary__icon {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: 10px;
}

.bootstrap-responsive--narrow .bootstrap-summary__title {
    font-size: 18px;
}

.bootstrap-responsive--narrow .bootstrap-plan {
    margin-top: var(--bootstrap-space-3);
}

.bootstrap-responsive--narrow .bootstrap-step {
    min-height: 40px;
}

.bootstrap-responsive--narrow .bootstrap-step__state {
    margin-left: var(--bootstrap-space-2);
}

.bootstrap-responsive--narrow .bootstrap-action-bar {
    min-height: 58px;
    max-height: 58px;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: 10px;
    padding-bottom: 10px;
}

.bootstrap-responsive--narrow .bootstrap-action-bar__actions {
    flex-grow: 1;
    width: 100%;
}

.bootstrap-responsive--narrow .bootstrap-button {
    min-width: 0;
    margin-left: 0;
}

.bootstrap-responsive--narrow .bootstrap-button--primary {
    flex-grow: 1;
}

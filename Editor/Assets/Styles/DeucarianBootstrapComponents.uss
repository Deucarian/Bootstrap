/* Compact plan, progressive details, persistent action dock, and icon bindings. */
.bootstrap-plan {
    flex-shrink: 0;
    min-width: 0;
    margin-top: var(--bootstrap-space-4);
}

.bootstrap-steps {
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border-soft);
    border-right-color: var(--bootstrap-border-soft);
    border-top-color: var(--bootstrap-border-soft);
    border-bottom-color: var(--bootstrap-border-soft);
    border-top-left-radius: var(--bootstrap-radius);
    border-top-right-radius: var(--bootstrap-radius);
    border-bottom-right-radius: var(--bootstrap-radius);
    border-bottom-left-radius: var(--bootstrap-radius);
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-step {
    flex-shrink: 0;
    min-width: 0;
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: var(--bootstrap-space-3);
    padding-top: 7px;
    padding-bottom: 7px;
    border-left-width: 2px;
    border-bottom-width: 1px;
    border-left-color: transparent;
    border-bottom-color: var(--bootstrap-border-soft);
    background-color: transparent;
}

.bootstrap-step--pending {
    border-left-color: transparent;
}

.bootstrap-step--current {
    border-left-color: var(--bootstrap-info);
    background-color: var(--bootstrap-surface-strong);
}

.bootstrap-step--complete {
    border-left-color: var(--bootstrap-success);
}

.bootstrap-step--failed {
    border-left-color: var(--bootstrap-error);
    background-color: var(--bootstrap-surface-strong);
}

.bootstrap-step__number {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-right: var(--bootstrap-space-2);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
    border-bottom-left-radius: 11px;
    background-color: var(--bootstrap-surface-raised);
    color: var(--bootstrap-text-muted);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 10px;
}

.bootstrap-step--current .bootstrap-step__number {
    background-color: var(--bootstrap-info);
    color: var(--bootstrap-on-accent);
}

.bootstrap-step--complete .bootstrap-step__number {
    background-color: var(--bootstrap-success);
    color: var(--bootstrap-on-accent);
}

.bootstrap-step--failed .bootstrap-step__number {
    background-color: var(--bootstrap-error);
    color: var(--bootstrap-on-accent);
}

.bootstrap-step__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--bootstrap-text);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-step__state {
    flex-shrink: 0;
    margin-left: var(--bootstrap-space-3);
    color: var(--bootstrap-text-muted);
    font-size: 10px;
    white-space: nowrap;
}

.bootstrap-step--current .bootstrap-step__state {
    color: var(--bootstrap-info);
}

.bootstrap-step--complete .bootstrap-step__state {
    color: var(--bootstrap-success);
}

.bootstrap-step--failed .bootstrap-step__state {
    color: var(--bootstrap-error);
}

.bootstrap-details {
    flex-shrink: 0;
    min-width: 0;
    margin-top: var(--bootstrap-space-3);
}

.bootstrap-details__foldout {
    min-height: 26px;
    color: var(--bootstrap-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-details__foldout:hover {
    color: var(--bootstrap-text);
}

.bootstrap-details__foldout:focus {
    color: var(--bootstrap-focus);
}

.bootstrap-details__content {
    min-width: 0;
    margin-top: var(--bootstrap-space-2);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    padding-top: var(--bootstrap-space-3);
    padding-bottom: var(--bootstrap-space-3);
    border-left-width: 1px;
    border-left-color: var(--bootstrap-border-soft);
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-details__controls {
    min-width: 0;
    margin-top: var(--bootstrap-space-2);
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.bootstrap-detail-row {
    min-width: 0;
    margin-bottom: var(--bootstrap-space-2);
}

.bootstrap-detail-row__label {
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    -unity-font-style: bold;
}

.bootstrap-detail-row__value {
    margin-top: 2px;
    color: var(--bootstrap-text);
    font-size: 10px;
    white-space: normal;
}

.bootstrap-action-bar {
    flex-shrink: 0;
    min-height: 58px;
    max-height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-top-color: var(--bootstrap-border-soft);
    background-color: var(--bootstrap-surface-raised);
}

.bootstrap-action-bar__actions {
    flex-shrink: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.bootstrap-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 104px;
    height: 36px;
    margin-left: var(--bootstrap-space-2);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border);
    border-right-color: var(--bootstrap-border);
    border-top-color: var(--bootstrap-border);
    border-bottom-color: var(--bootstrap-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: var(--bootstrap-surface-soft);
    color: var(--bootstrap-text);
    -unity-font-style: bold;
    white-space: nowrap;
}

.bootstrap-button__label {
    color: var(--bootstrap-text);
    -unity-font-style: bold;
    white-space: nowrap;
}

.bootstrap-button:hover {
    border-left-color: var(--bootstrap-border-active);
    border-right-color: var(--bootstrap-border-active);
    border-top-color: var(--bootstrap-border-active);
    border-bottom-color: var(--bootstrap-border-active);
    background-color: var(--bootstrap-surface-strong);
}

.bootstrap-button:active {
    background-color: var(--bootstrap-bg);
}

.bootstrap-button:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--bootstrap-focus);
    border-right-color: var(--bootstrap-focus);
    border-top-color: var(--bootstrap-focus);
    border-bottom-color: var(--bootstrap-focus);
}

.bootstrap-button:disabled {
    opacity: 0.48;
}

.bootstrap-button--primary {
    min-width: 176px;
    border-left-color: var(--bootstrap-accent);
    border-right-color: var(--bootstrap-accent);
    border-top-color: var(--bootstrap-accent);
    border-bottom-color: var(--bootstrap-accent);
    background-color: var(--bootstrap-accent);
    color: var(--bootstrap-on-accent);
}

.bootstrap-button--primary .bootstrap-button__label {
    color: var(--bootstrap-on-accent);
}

.bootstrap-button--primary .bootstrap-icon {
    -unity-background-image-tint-color: var(--bootstrap-on-accent);
}

.bootstrap-button--primary:hover {
    background-color: var(--bootstrap-accent-hover);
}

.bootstrap-button--primary:active {
    background-color: var(--bootstrap-accent-active);
}

.bootstrap-button--quiet {
    min-width: 80px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
    background-color: transparent;
    color: var(--bootstrap-text-muted);
}

.bootstrap-button--quiet .bootstrap-button__label {
    color: var(--bootstrap-text-muted);
}

.bootstrap-link:focus {
    color: var(--bootstrap-focus);
}

.bootstrap-icon {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-right: var(--bootstrap-space-2);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bootstrap-text-muted);
}

.bootstrap-icon--success {
    background-image: url("../Icons/Lucide/circle-check-big.png");
    -unity-background-image-tint-color: var(--bootstrap-success);
}

.bootstrap-icon--warning,
.bootstrap-icon--review {
    background-image: url("../Icons/Lucide/triangle-alert.png");
    -unity-background-image-tint-color: var(--bootstrap-warning);
}

.bootstrap-icon--error {
    background-image: url("../Icons/Lucide/circle-x.png");
    -unity-background-image-tint-color: var(--bootstrap-error);
}

.bootstrap-icon--loading {
    background-image: url("../Icons/Lucide/loader-circle.png");
    -unity-background-image-tint-color: var(--bootstrap-info);
}

.bootstrap-icon--install {
    background-image: url("../Icons/Lucide/download.png");
}

.bootstrap-icon--repair {
    background-image: url("../Icons/Lucide/wrench.png");
}

.bootstrap-icon--open {
    background-image: url("../Icons/Lucide/external-link.png");
}

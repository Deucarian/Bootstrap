/* Setup path, completion receipt, progressive details, and action dock. */
.bootstrap-setup-flow,
.bootstrap-completion-receipt {
    flex-shrink: 0;
    min-width: 0;
    margin-top: var(--bootstrap-space-4);
}

.bootstrap-setup-flow__heading {
    min-width: 0;
    margin-bottom: 10px;
}

.bootstrap-setup-flow__title {
    margin-top: 3px;
    color: var(--bootstrap-text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-setup-items {
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
}

.bootstrap-setup-item {
    flex-shrink: 0;
    min-width: 0;
    width: 100%;
    min-height: 88px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: 12px;
    padding-bottom: 12px;
    border-left-width: 2px;
    border-left-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: var(--bootstrap-border-soft);
    background-color: transparent;
}

.bootstrap-setup-item--destination {
    border-left-color: var(--bootstrap-accent);
    background-color: var(--bootstrap-accent-wash);
}

.bootstrap-setup-item--current {
    border-left-color: var(--bootstrap-info);
    background-color: var(--bootstrap-info-wash);
}

.bootstrap-setup-item--attention {
    border-left-color: var(--bootstrap-warning);
    background-color: var(--bootstrap-warning-wash);
}

.bootstrap-setup-item--failed {
    border-left-color: var(--bootstrap-error);
    background-color: var(--bootstrap-error-wash);
}

.bootstrap-setup-item__marker {
    width: 30px;
    min-width: 30px;
    height: 30px;
    margin-right: 11px;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border);
    border-right-color: var(--bootstrap-border);
    border-top-color: var(--bootstrap-border);
    border-bottom-color: var(--bootstrap-border);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    background-color: var(--bootstrap-bg);
}

.bootstrap-setup-item__number {
    color: var(--bootstrap-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bootstrap-setup-item__state-icon {
    display: none;
    width: 15px;
    min-width: 15px;
    height: 15px;
    margin-right: 0;
}

.bootstrap-setup-item--current .bootstrap-setup-item__number,
.bootstrap-setup-item--ready .bootstrap-setup-item__number,
.bootstrap-setup-item--complete .bootstrap-setup-item__number,
.bootstrap-setup-item--attention .bootstrap-setup-item__number,
.bootstrap-setup-item--failed .bootstrap-setup-item__number {
    display: none;
}

.bootstrap-setup-item--current .bootstrap-setup-item__state-icon,
.bootstrap-setup-item--ready .bootstrap-setup-item__state-icon,
.bootstrap-setup-item--complete .bootstrap-setup-item__state-icon,
.bootstrap-setup-item--attention .bootstrap-setup-item__state-icon,
.bootstrap-setup-item--failed .bootstrap-setup-item__state-icon {
    display: flex;
}

.bootstrap-setup-item__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-setup-item__role {
    color: var(--bootstrap-text-faint);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    white-space: nowrap;
}

.bootstrap-setup-item--destination .bootstrap-setup-item__role {
    color: var(--bootstrap-accent);
}

.bootstrap-setup-item__title {
    margin-top: 3px;
    color: var(--bootstrap-text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-setup-item__detail {
    margin-top: 3px;
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    white-space: normal;
}

.bootstrap-setup-item__state {
    flex-shrink: 0;
    max-width: 112px;
    margin-left: var(--bootstrap-space-3);
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.bootstrap-setup-item--current .bootstrap-setup-item__state { color: var(--bootstrap-info); }
.bootstrap-setup-item--ready .bootstrap-setup-item__state,
.bootstrap-setup-item--complete .bootstrap-setup-item__state { color: var(--bootstrap-success); }
.bootstrap-setup-item--attention .bootstrap-setup-item__state { color: var(--bootstrap-warning); }
.bootstrap-setup-item--failed .bootstrap-setup-item__state { color: var(--bootstrap-error); }

.bootstrap-receipt-items {
    min-width: 0;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--bootstrap-border-soft);
}

.bootstrap-receipt-item {
    flex-shrink: 0;
    min-width: 0;
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--bootstrap-space-2);
    padding-right: var(--bootstrap-space-2);
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--bootstrap-border-soft);
}

.bootstrap-receipt-item__icon {
    width: 16px;
    min-width: 16px;
    height: 16px;
    margin-right: 9px;
}

.bootstrap-receipt-item__copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bootstrap-receipt-item__title {
    color: var(--bootstrap-text);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-receipt-item__summary {
    margin-top: 2px;
    color: var(--bootstrap-success);
    font-size: 8px;
    white-space: normal;
}

.bootstrap-details {
    flex-shrink: 0;
    min-width: 0;
    margin-top: var(--bootstrap-space-3);
}

.bootstrap-details__foldout {
    min-height: 24px;
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
}

.bootstrap-details__foldout:hover { color: var(--bootstrap-text); }
.bootstrap-details__foldout:focus { color: var(--bootstrap-focus); }

.bootstrap-details__content {
    min-width: 0;
    margin-top: 5px;
    margin-left: 6px;
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-2);
    padding-top: var(--bootstrap-space-2);
    padding-bottom: var(--bootstrap-space-2);
    border-left-width: 1px;
    border-left-color: var(--bootstrap-border-soft);
}

.bootstrap-details__controls {
    min-width: 0;
    margin-top: var(--bootstrap-space-2);
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.bootstrap-detail-row {
    min-width: 0;
    margin-bottom: var(--bootstrap-space-2);
}

.bootstrap-detail-row__label {
    color: var(--bootstrap-text-faint);
    font-size: 8px;
    -unity-font-style: bold;
}

.bootstrap-detail-row__value {
    margin-top: 2px;
    color: var(--bootstrap-text);
    font-size: 9px;
    white-space: normal;
}

.bootstrap-action-bar {
    flex-shrink: 0;
    min-height: 60px;
    max-height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--bootstrap-space-4);
    padding-right: var(--bootstrap-space-4);
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-top-color: var(--bootstrap-border-soft);
    background-color: var(--bootstrap-surface-raised);
}

.bootstrap-action-bar--passive {
    justify-content: center;
}

.bootstrap-action-bar__passive {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.bootstrap-action-bar__passive-text {
    min-width: 0;
    color: var(--bootstrap-text-muted);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.bootstrap-action-bar__actions {
    flex-shrink: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.bootstrap-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 104px;
    height: 38px;
    margin-left: var(--bootstrap-space-2);
    padding-left: var(--bootstrap-space-3);
    padding-right: var(--bootstrap-space-3);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--bootstrap-border);
    border-right-color: var(--bootstrap-border);
    border-top-color: var(--bootstrap-border);
    border-bottom-color: var(--bootstrap-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: transparent;
    color: var(--bootstrap-text);
    -unity-font-style: bold;
    white-space: nowrap;
}

.bootstrap-button__label {
    color: var(--bootstrap-text);
    -unity-font-style: bold;
    white-space: nowrap;
}

.bootstrap-button:hover {
    border-left-color: var(--bootstrap-border-active);
    border-right-color: var(--bootstrap-border-active);
    border-top-color: var(--bootstrap-border-active);
    border-bottom-color: var(--bootstrap-border-active);
    background-color: var(--bootstrap-surface-soft);
}

.bootstrap-button:active { background-color: var(--bootstrap-bg); }

.bootstrap-button:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--bootstrap-focus);
    border-right-color: var(--bootstrap-focus);
    border-top-color: var(--bootstrap-focus);
    border-bottom-color: var(--bootstrap-focus);
}

.bootstrap-button:disabled { opacity: 0.48; }

.bootstrap-button--primary {
    min-width: 206px;
    border-left-color: var(--bootstrap-accent);
    border-right-color: var(--bootstrap-accent);
    border-top-color: var(--bootstrap-accent);
    border-bottom-color: var(--bootstrap-accent);
    background-color: var(--bootstrap-accent);
    color: var(--bootstrap-on-accent);
}

.bootstrap-button--primary .bootstrap-button__label { color: var(--bootstrap-on-accent); }
.bootstrap-button--primary .bootstrap-icon { -unity-background-image-tint-color: var(--bootstrap-on-accent); }
.bootstrap-button--primary:hover { background-color: var(--bootstrap-accent-hover); }
.bootstrap-button--primary:active { background-color: var(--bootstrap-accent-active); }

.bootstrap-button--quiet {
    min-width: 80px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
    background-color: transparent;
    color: var(--bootstrap-text-muted);
}

.bootstrap-icon {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-right: var(--bootstrap-space-2);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bootstrap-text-muted);
}

.bootstrap-icon--success {
    background-image: url("../Icons/Lucide/circle-check-big.png");
    -unity-background-image-tint-color: var(--bootstrap-success);
}

.bootstrap-icon--warning,
.bootstrap-icon--review {
    background-image: url("../Icons/Lucide/triangle-alert.png");
    -unity-background-image-tint-color: var(--bootstrap-warning);
}

.bootstrap-icon--error {
    background-image: url("../Icons/Lucide/circle-x.png");
    -unity-background-image-tint-color: var(--bootstrap-error);
}

.bootstrap-icon--loading {
    background-image: url("../Icons/Lucide/loader-circle.png");
    -unity-background-image-tint-color: var(--bootstrap-info);
}

.bootstrap-icon--install { background-image: url("../Icons/Lucide/download.png"); }
.bootstrap-icon--repair { background-image: url("../Icons/Lucide/wrench.png"); }
.bootstrap-icon--open { background-image: url("../Icons/Lucide/external-link.png"); }
.bootstrap-icon--package-open { background-image: url("../Icons/Lucide/package-open.png"); }
